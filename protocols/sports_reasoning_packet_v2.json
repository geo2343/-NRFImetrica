{
  "contract_id": "NRFIMETRICA_SPORTS_REASONING_PACKET_V2",
  "status": "ACTIVE_REQUIRED_EXTENSION",
  "parent_protocol": "NRFIMETRICA_MOTHER_V3_AUTONOMOUS",
  "kernel_version": "NRFIM-KERNEL-1.4-DETERMINISTIC-SEMANTIC-CUSTODY",
  "custody_version": "SEMANTIC-CUSTODY-1.0",
  "purpose": "PROVE_THE_CAUSAL_SPORTS_JUDGMENT_WAS_ACTUALLY_RESEARCHED_WITHOUT_TURNING_CAUSAL_REASONING_INTO_A_SCORE",
  "separation_rule": "SPORTS_JUDGMENT_IS_ALWAYS_SEPARATE_FROM_A1_A8_CERTIFICATION",
  "one_packet_per_registered_game": true,
  "physical_chain": [
    "KERNEL_RESEARCH_QUERY",
    "KERNEL_ATTESTED_RETRIEVAL",
    "KERNEL_GENERATED_TOOL_EVENT_ID",
    "KERNEL_GENERATED_EVIDENCE_ID_AND_SNAPSHOT_HASH",
    "KERNEL_DERIVED_SOURCE_FAMILY",
    "FACTUAL_CLAIM_TO_EVIDENCE_MAP",
    "CAUSAL_ANALYSIS",
    "ADVERSARIAL_FALSIFICATION",
    "SPORTS_VERDICT",
    "PACKET_FREEZE_HASH",
    "DRIVE_ATTESTATION",
    "KERNEL_PROCESS_AUDITOR_0.3"
  ],
  "semantic_custody": {
    "model_may_generate_evidence_id": false,
    "model_may_generate_tool_event_id": false,
    "model_may_set_retrieved_at": false,
    "model_may_set_data_available_since": false,
    "sports_evidence_requires_kernel_attested_retrieval": true,
    "discovery_only_is_evidence": false,
    "source_family_is_kernel_derived": true,
    "same_declared_origin_collapses": true,
    "exact_content_collapses": true,
    "semantic_overlap_threshold": 0.80,
    "evidence_core_is_immutable_after_insert": true
  },
  "adaptive_depth": {
    "version": "ADAPTIVE-CONTRADICTION-1.0",
    "legacy_3_5_7_floors_apply_to_new_packets": false,
    "minimum_families_no_material_contradiction": 2,
    "minimum_families_material_contradiction": 4,
    "governing_open_contradiction_blocks_analysis_complete": true,
    "analysis_complete_requires_saturation_reached": true,
    "last_two_independent_families_are_kernel_recorded": true,
    "note": "SOURCE COUNTS ARE PROCESS DEPTH CONTROLS, NEVER SPORTS VOTES"
  },
  "required_dimensions": [
    "TOP_1ST",
    "BOTTOM_1ST",
    "STARTER_CURRENT_FORM",
    "TOP_ORDER_MATCHUP",
    "FIRST_INNING_SPECIFIC",
    "COUNTEREVIDENCE"
  ],
  "required_reasoning_objects": [
    "FIRST_INNING_FACTORS_TOP_AND_BOTTOM",
    "CENTRAL_NRFI_CASE",
    "BEST_YRFI_RIVAL_WITH_MATERIALIZATION_PATH",
    "STRONGEST_COUNTEREVIDENCE",
    "FALSIFICATION_AGAINST_NRFI",
    "FALSIFICATION_AGAINST_YRFI",
    "ADVERSARIAL_BALANCE",
    "CAUSAL_CLUSTERS",
    "DOMINANT_FACTOR_WHEN_APPLICABLE",
    "UNRESOLVED_CONTRADICTIONS",
    "GOVERNING_UNCERTAINTY",
    "WHAT_WOULD_CHANGE_THE_DECISION",
    "WHY_RESEARCH_STOPPED"
  ],
  "yrfi_materialization_path": {
    "required": true,
    "required_fields": ["half","path_type","vulnerability_activator","evidence_ids","steps"],
    "one_swing_requires": ["batter_or_profile","pitch_or_zone_vulnerability"],
    "generic_hr_statement_is_sufficient": false
  },
  "adversarial_balance": {
    "nrfi_evidence_ids_required": true,
    "yrfi_evidence_ids_required": true,
    "equal_number_of_metrics_required": false,
    "principle": "PARITY_OF_REAL_EVIDENCE_AND_EFFORT_WITHOUT_HIDDEN_SCORING"
  },
  "first_inning_materiality": {
    "top_half_factor_required": true,
    "bottom_half_factor_required": true,
    "full_game_data_allowed": true,
    "full_game_data_role": "MODIFIER_ONLY_WITH_EXPLICIT_FIRST_INNING_LINK",
    "full_game_only_dominant_factor_forbidden": true,
    "first_inning_metric_as_sole_gate_forbidden": true,
    "token_frequency_scoring_forbidden": true
  },
  "lineup_state": {
    "values": ["PROJECTED","CONFIRMED","MIXED"],
    "projected_and_confirmed_analysis_must_be_separate": true,
    "projected_state_does_not_automatically_abort_research": true
  },
  "factual_claim_rule": "EVERY_FACTUAL_CLAIM_REQUIRES_AT_LEAST_ONE_KERNEL_ATTESTED_CURRENT_RUN_GAME_EVIDENCE_ID",
  "full_game_rule": "FULL_GAME_DATA_MAY_ONLY_APPEAR_AS_A MODIFIER WITH EXPLICIT FIRST_INNING CAUSAL LINK AND EVIDENCE IDS",
  "unknown_rule": "UNKNOWN_IS_NOT_RISK_UNLESS_A_SPECIFIC_MATERIALIZATION_PATH_CONNECTS_IT_TO_FIRST_INNING_RUN_PRODUCTION",
  "rejection_rule": "NO_PLAY_AND_RESEARCH_ONLY_REQUIRE_THE_SAME_CAUSAL_BURDEN_AS_A_POSITIVE_JUDGMENT",
  "temporal_rule": "RETRIEVED_AT_AND_DATA_AVAILABILITY_ARE_KERNEL_OWNED; FUTURE_DATA_AND_BACKDATING_ARE_FORBIDDEN",
  "refutability_rule": "WHAT_WOULD_CHANGE_MUST_BE_OBSERVABLE_AND_TIME_BOUND; METRIC_THRESHOLD_REQUIRES_METRIC_OPERATOR_THRESHOLD",
  "freeze_rule": "A_TERMINAL_PACKET_IS_IMMUTABLE; ANY_CAUSAL_CHANGE_REQUIRES_A_NEW_VERSION_LINKED_BY_PREVIOUS_PACKET_HASH",
  "drive_rule": "EVERY_TERMINAL_PACKET_MUST_HAVE_A_VERIFIED_DRIVE_ARTIFACT_BOUND_TO_ITS_PACKET_HASH_BEFORE_SPORTS_REASONING_SLATE_CAN_SEAL",
  "process_audit_rule": "ANALYSIS_COMPLETE_COUNTS_ONLY_WHEN_PROCESS_AUDIT_PASS_AND_DRIVE_HASH_MATCH_EXIST",
  "process_auditor_authority": "KERNEL_PROCESS_AUDITOR_0.3 MAY PASS FAIL OR REVIEW PROCESS; MAY NOT REPLACE THE SPORTS VERDICT WITH A SECOND VOTE",
  "terminal_states": [
    "ANALYSIS_COMPLETE",
    "RESEARCH_INCOMPLETE",
    "INFORMATION_UNAVAILABLE",
    "NOT_EXECUTABLE",
    "WITHDRAWN_POST_FREEZE",
    "PROCESS_FAIL"
  ],
  "slate_truth_rule": "THE_KERNEL_GENERATES_EXACT_N_OF_TOTAL_ANALYSIS_COMPLETE; THE_AGENT_CANNOT_ROUND_OR_FREEWRITE_FULL_SLATE_COMPLETION",
  "tables": [
    "research_kernel_queries",
    "research_tool_events",
    "research_source_families",
    "evidence",
    "sports_reasoning_packets",
    "sports_reasoning_claims",
    "sports_process_audits",
    "research_drive_artifacts"
  ],
  "runtime_api": "api/research.py"
}
